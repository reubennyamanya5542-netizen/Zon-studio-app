{
  "name": "zon-studio",
  "version": "1.1.0",
  "private": true,
  "description": "Zon Studio carousel editor",
  "scripts": {
    "build:web": "node build.mjs",
    "build:android-assets": "npx capacitor-assets generate --android",
    "cap:sync": "npx cap sync android",
    "android:debug": "npm run build:web && npx cap add android && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/media": "^7.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^6.0.0",
    "sharp": "^0.33.0"
  }
}
