name: Make keystore
on: workflow_dispatch
jobs:
  make:
    runs-on: ubuntu-latest
    steps:
      - run: |
          keytool -genkeypair -keystore zon.keystore -alias zon -keyalg RSA -keysize 2048 -validity 10000 -storepass "${{ secrets.KEYSTORE_PASSWORD }}" -keypass "${{ secrets.KEYSTORE_PASSWORD }}" -dname "CN=Zon Group Dev"
          base64 -w0 zon.keystore > keystore_base64.txt
      - uses: actions/upload-artifact@v4
        with:
          name: zon-keystore
          path: |
            zon.keystore
            keystore_base64.txt
